    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.9",
    "pg-boss": "^12.31.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.4"
