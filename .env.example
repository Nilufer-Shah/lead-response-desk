NODE_ENV=development
TZ=Asia/Kolkata
APP_URL=http://localhost:3000
DATABASE_URL=postgres://lead_desk_app:lead_desk_app@localhost:5432/lead_desk
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
POSTGRES_OWNER_PASSWORD=replace-owner-password
POSTGRES_APP_PASSWORD=replace-app-password
SESSION_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DEMO_MODE=false
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-owner-password
OWNER_RESET_PASSWORD=
EMAIL_FROM=leads@example.com
SMTP_URL=
REPORTS_DIR=/var/lib/lead-desk/reports
CHROMIUM_PATH=/usr/bin/chromium
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WHATSAPP_PROVIDER=disabled
AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v26.0
META_AD_ACCOUNT_ID=
META_CONNECTION_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep this quoted when using escaped newlines: "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_POLL_MINUTES=1
