# Runtime mode. Use production on the VPS.
NODE_ENV=development
# Application timezone; business clocks are fixed to Asia/Kolkata.
TZ=Asia/Kolkata
# Public application URL, including https:// in production.
APP_URL=http://localhost:3000
# Public hostname used by Caddy. Confirm the domain before purchasing or changing DNS.
APP_DOMAIN=localhost
# Loopback port used only with compose.existing-proxy.yaml.
LRD_WEB_PORT=3010
# App-role PostgreSQL connection used outside Compose; Compose overrides the hostname.
DATABASE_URL=postgres://lead_desk_app:replace-app-password@localhost:5432/lead_desk
# Fixed tenant seeded by the initial migration.
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
# Database-owner password used only by PostgreSQL and the migration container.
POSTGRES_OWNER_PASSWORD=replace-owner-password
# Non-superuser password used by the web and worker containers.
POSTGRES_APP_PASSWORD=replace-app-password
# Random session signing secret of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# First production owner created by the one-shot bootstrap command.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
# Display name for the first production owner.
BOOTSTRAP_OWNER_NAME=Owner
# Initial owner password; rotate it after first sign-in.
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-owner-password
# One-time value used only when running npm run owner:reset-password.
OWNER_RESET_PASSWORD=
# Keep Meta off until the HTTPS webhook and Business Manager setup are complete.
META_CONNECTION_ENABLED=false
# Meta app identifier.
META_APP_ID=
# Meta app secret used to validate raw webhook signatures.
META_APP_SECRET=
# Private webhook verification token chosen by the deployment team.
META_VERIFY_TOKEN=
# Server-only Meta system-user access token; never expose it to the browser.
META_SYSTEM_USER_TOKEN=
# Meta Graph API version used for hydration and reconciliation.
META_GRAPH_VERSION=v26.0
# Enables the read-only Google Sheets polling worker.
GOOGLE_SHEETS_ENABLED=false
# Google service-account client_email shared with the Sheet as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Google service-account private_key; keep quoted when using escaped newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Poll interval for active Google Sheet connections.
GOOGLE_SHEETS_POLL_MINUTES=1
