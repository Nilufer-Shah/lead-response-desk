FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx tsc --noEmit

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-inter \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 app && useradd --system --uid 1001 --gid app app
RUN mkdir -p /var/lib/lead-desk/reports /var/spool/lead-desk && chown -R app:app /var/lib/lead-desk /var/spool/lead-desk
COPY --from=build --chown=app:app /app ./
USER app
CMD ["node", "--import", "tsx", "src/worker/index.ts"]
